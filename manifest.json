{
  "name": "PDF Tools",
  "short_name": "PDF Tools",
  "description": "PDF reader, document scanner and 36 PDF tools — merge, split, sign, annotate, OCR, compress and more. No uploads. Works offline.",
  "start_url": "./PDFTools.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e1014",
  "theme_color": "#0e1014",
  "lang": "en",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [],
  "shortcuts": [
    {
      "name": "Scan document",
      "url": "./PDFTools.html#scan",
      "description": "Scan with your camera"
    },
    {
      "name": "My Files",
      "url": "./PDFTools.html#files",
      "description": "Your saved documents"
    },
    {
      "name": "Merge PDF",
      "url": "./PDFTools.html#tool/merge",
      "description": "Combine multiple PDFs"
    },
    {
      "name": "Sign PDF",
      "url": "./PDFTools.html#tool/editor",
      "description": "Add a signature"
    }
  ],
  "file_handlers": [
    {
      "action": "./PDFTools.html",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
